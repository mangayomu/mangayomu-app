{
  "name": "mangayomu",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "server-android",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --workspace @mangayomu/client run dev",
    "dev:server": "npm --workspace @mangayomu/server run dev",
    "serve": "npm run build:client && npm --workspace @mangayomu/server run start",
    "build:client": "npm --workspace @mangayomu/client run build",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "tauri:prepare": "node scripts/bundle-tauri-server.mjs",
    "build:tauri": "node scripts/build-tauri.mjs",
    "build:tauri:app": "node scripts/build-tauri.mjs --no-dmg",
    "dev:tauri": "node scripts/bundle-tauri-server.mjs && tauri dev",
    "build:android": "node scripts/build-android.mjs client",
    "build:android-with-server": "node scripts/build-android.mjs withServer",
    "release": "node scripts/release.mjs",
    "install:android": "npm run build:android && node scripts/install-android.mjs client",
    "install:android-with-server": "npm run build:android-with-server && node scripts/install-android.mjs withServer"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0"
  }
}

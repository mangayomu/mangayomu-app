# =============================================================================
# What never enters the repository, and why.
#
# Rule of thumb: the repository holds source, configuration and documentation.
# Anything that is (a) produced by the build, (b) downloaded, or (c) a binary
# installer is either regenerated by a script or published as a GitHub Release
# asset - never committed. See "Releases" in README.md.
# =============================================================================

# --- dependencies ------------------------------------------------------------
node_modules/
client/node_modules/
server/node_modules/

# --- build output: regenerated by the build scripts --------------------------
dist/
client/public/mangayomu-runtime.json

# --- distributables: published as GitHub Release assets ----------------------
builds/
*.apk
*.aab
*.dmg
*.msi
*.AppImage
*.deb
*.rpm
*.snap
*.blockmap

# --- Android: build inputs fetched by scripts/bundle-android-server.mjs ------
# The Node.js Mobile runtime (libnode.so) and its headers (node/v8/openssl/uv)
# are pinned by sha256 in that script and re-downloaded when missing.
android/app/src/*/jniLibs/
android/app/src/*/cpp/include/
android/app/src/withServer/assets/
android/app/src/main/assets/public/
android/app/src/main/assets/nodejs-project/
android/app/build/
android/app/.cxx/
android/.gradle/
android/capacitor-cordova-android-plugins/
android/local.properties

# --- desktop (Tauri): see src-tauri/.gitignore -------------------------------
# target/, gen/, binaries/, resources/ and .cache/ are staged inputs or Rust
# build output; scripts/bundle-tauri-server.mjs recreates them.

# --- data and runtime state --------------------------------------------------
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal

# --- signing material: a committed key can never be taken back ----------------
# Android release keystores and Apple provisioning profiles belong outside the
# repository, next to the credentials that protect them.
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
.npmrc

# --- local scratch (kept on disk, not part of the product) -------------------
fullfill/
reference/
.pi-subagents/
.agents/
.serena/
snapshots/
client-kobo/

# --- agent state: local working notes, never published ------------------------
.claude/

# --- OS, editor, exports -----------------------------------------------------
.DS_Store
telegraph*.jpg
telegraph*.png
telegram*.jpg
tachiyomi*.proto
